[Unit]
Description=kuaishou workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/kuaishou
ExecStart=/home/ubuntu/leo-project/kuaishou/.venv/bin/python -m web --port 8776 --public-origin https://d.58nft.net:9454
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
